generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  password_hash String
  role          String        @default("buyer")
  balance       Decimal       @default(0)
  is_banned     Boolean       @default(false)
  created_at    DateTime      @default(now())
  products      Product[]     @relation("SellerProducts")
  orders        Order[]       @relation("BuyerOrders")
  transactions  Transaction[]
  payments      Payment[]
  notifications Notification[] 
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          Int          @id @default(autoincrement())
  sellerId    Int          @map("seller_id")
  seller      User         @relation("SellerProducts", fields: [sellerId], references: [id])
  categoryId  Int          @map("category_id")
  category    Category     @relation(fields: [categoryId], references: [id])
  title       String
  description String       @default("")
  price       Decimal
  stock       Int          @default(0)
  rating      Decimal      @default(0)
  status      String       @default("active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  keys        ProductKey[]
  orderItems  OrderItem[]   // обратная связь для OrderItem
}

model ProductKey {
  id        Int        @id @default(autoincrement())
  productId Int        @map("product_id")
  product   Product    @relation(fields: [productId], references: [id])
  keyValue  String     @map("key_value")
  isSold    Boolean    @default(false) @map("is_sold")
  orderId   Int?       @map("order_id")
  createdAt DateTime   @default(now()) @map("created_at")
  orderItem OrderItem? // обратная связь (ключ может быть ещё не продан)

  @@index([keyValue])
  @@map("product_keys")
}

model Order {
  id           Int           @id @default(autoincrement())
  buyerId      Int           @map("buyer_id")
  buyer        User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  totalPrice   Decimal       @map("total_price")
  status       String        @default("created")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  items        OrderItem[]
  transactions Transaction[]
  payments     Payment[] 

  @@map("orders")
}

model OrderItem {
  id           Int        @id @default(autoincrement())
  orderId      Int        @map("order_id")
  order        Order      @relation(fields: [orderId], references: [id])
  productId    Int        @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  productKeyId Int        @unique @map("product_key_id")
  productKey   ProductKey @relation(fields: [productKeyId], references: [id])
  price        Decimal

  @@map("order_items")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  type      String   // purchase, sale, commission, replenish, withdrawal
  amount    Decimal
  orderId   Int?     @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

model Payment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  amount     Decimal
  status     String   @default("pending")   // pending, completed, failed, cancelled
  externalId String   @unique @map("external_id")  // ID в платёжном шлюзе (UUID)
  orderId    Int?     @map("order_id")      // связь с заказом (null при пополнении баланса)
  order      Order?   @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  type      String   // order_paid, order_cancelled, welcome, etc.
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}