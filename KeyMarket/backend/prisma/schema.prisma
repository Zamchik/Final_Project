// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------- Enums -------------------

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN 
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  DELIVERED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  PURCHASE
  SALE
  COMMISSION
  REPLENISH
  WITHDRAWAL
}

enum NotificationType {
  ORDER_PAID
  ORDER_CANCELLED
  WELCOME
}

enum ProductType {
  GAME
  DLC
}

// ------------------- Models -------------------

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String         @map("password_hash")
  role         UserRole       @default(BUYER)
  balance      Decimal        @default(0)
  bannedAt     DateTime?      @map("banned_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  verifiedAt   DateTime?      @map("verified_at")

  products      Product[]     @relation("SellerProducts")
  orders        Order[]       @relation("BuyerOrders")
  transactions  Transaction[]
  payments      Payment[]
  notifications Notification[]
  reviews       Review[]

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  userConversations   Conversation[] @relation("UserConversations")
  adminConversations  Conversation[] @relation("AdminConversations")
  messages            Message[]

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          Int           @id @default(autoincrement())
  sellerId    Int           @map("seller_id")
  seller      User          @relation("SellerProducts", fields: [sellerId], references: [id])
  categoryId  Int           @map("category_id")
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  description String        @default("")
  price       Decimal
  stock       Int           @default(0)
  rating      Decimal       @default(0)
  status      ProductStatus @default(ACTIVE)
  // Тип товара (GAME или DLC), по умолчанию GAME
  productType ProductType   @default(GAME) @map("product_type")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  imageUrl    String?       @map("image_url")

  keys       ProductKey[]
  orderItems OrderItem[]
  reviews    Review[]

  @@map("products")
}

model ProductKey {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  product   Product   @relation(fields: [productId], references: [id])
  keyValue  String    @map("key_value")
  soldAt    DateTime? @map("sold_at")
  orderId   Int?      @map("order_id")
  createdAt DateTime  @default(now()) @map("created_at")

  orderItem OrderItem?

  @@index([keyValue])
  @@map("product_keys")
}

model Order {
  id         Int         @id @default(autoincrement())
  buyerId    Int         @map("buyer_id")
  buyer      User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  totalPrice Decimal     @map("total_price")
  status     OrderStatus @default(CREATED)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  items        OrderItem[]
  transactions Transaction[]
  payments     Payment[]
  reviews      Review[]
  conversations Conversation[]

  @@map("orders")
}

model OrderItem {
  id           Int        @id @default(autoincrement())
  orderId      Int        @map("order_id")
  order        Order      @relation(fields: [orderId], references: [id])
  productId    Int        @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  productKeyId Int        @unique @map("product_key_id")
  productKey   ProductKey @relation(fields: [productKeyId], references: [id])
  price        Decimal

  @@map("order_items")
}

model Transaction {
  id        Int             @id @default(autoincrement())
  userId    Int             @map("user_id")
  user      User            @relation(fields: [userId], references: [id])
  type      TransactionType
  amount    Decimal
  orderId   Int?            @map("order_id")
  order     Order?          @relation(fields: [orderId], references: [id])
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("transactions")
}

model Payment {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  user       User          @relation(fields: [userId], references: [id])
  amount     Decimal
  status     PaymentStatus @default(PENDING)
  externalId String        @unique @map("external_id")
  orderId    Int?          @map("order_id")
  order      Order?        @relation(fields: [orderId], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   Int      @unique @map("order_id") // один отзыв на заказ
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int      // от 1 до 5
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

// Чат между покупателем и продавцом (по заказу) или тикет поддержки
model Conversation {
  id        Int       @id @default(autoincrement())
  type      String    // "ORDER" или "SUPPORT"
  orderId   Int?      @map("order_id")
  order     Order?    @relation(fields: [orderId], references: [id])
  buyerId   Int?      @map("buyer_id")
  buyer     User?     @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId  Int?      @map("seller_id")
  seller    User?     @relation("SellerConversations", fields: [sellerId], references: [id])
  userId    Int?      @map("user_id")
  user      User?     @relation("UserConversations", fields: [userId], references: [id])
  adminId   Int?      @map("admin_id")
  admin     User?     @relation("AdminConversations", fields: [adminId], references: [id])
  unreadBuyer   Int @default(0)
  unreadSeller  Int @default(0)
  unreadAdmin   Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@map("conversations")
}

// Сообщение в чате
model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int      @map("sender_id")
  sender         User     @relation(fields: [senderId], references: [id])
  text           String
  createdAt      DateTime @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")

  @@map("messages")
}