generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  role          String    @default("buyer")
  balance       Decimal   @default(0)
  is_banned     Boolean   @default(false)
  created_at    DateTime  @default(now())
}